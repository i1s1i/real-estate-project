# ==============================================================
# منصة العقار الذكية - الرياض
# ملف نموذج متغيرات البيئة (.env.example)
#
# ⚠️  هذا الملف مثال فقط - لا يحتوي على قيم حقيقية.
# انسخه إلى .env واملأ القيم الفعلية:
#     cp .env.example .env
# ==============================================================

# ---------------------------------------------------------------
# إعدادات Flask العامة
# ---------------------------------------------------------------
FLASK_ENV=development
# FLASK_ENV=production   ← استخدم هذا في الإنتاج

# مفتاح سري قوي (استخدم: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-super-secret-key-change-me

# ---------------------------------------------------------------
# قاعدة البيانات
# ---------------------------------------------------------------
# للتطوير المحلي (SQLite)
DATABASE_URL=sqlite:///app.db

# للإنتاج على Render (PostgreSQL) - يُعيَّن تلقائياً من Render
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------
# بيانات المشرف
# ---------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ---------------------------------------------------------------
# مفاتيح API الخارجية (أضف ما تحتاجه)
# ---------------------------------------------------------------
# Google Maps API
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenAI / Gemini (إذا استُخدمت لاحقاً)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=your-gemini-api-key

# البريد الإلكتروني (إذا احتجت إرسال إيميلات)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
